    "sync": "npm run vendor && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
